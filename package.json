{
  "name": "vocabmaster",
  "version": "1.0.1",
  "description": "CET-4/6, IELTS and TOEFL vocabulary learning desktop application",
  "author": "VocabMaster",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "dev:web": "vite --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:web": "vite build",
    "build:win": "vite build && electron-builder --win --x64",
    "pack:win": "vite build && electron-builder --win --x64 --dir",
    "pack:zip": "node scripts/pack-zip.cjs"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "echarts": "^6.1.0",
    "iconv-lite": "^0.6.3",
    "lucide-vue-next": "^0.468.0",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "xlsx": "npm:@e965/xlsx@^0.20.3"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^9.1.2",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12",
    "vite": "^6.1.0",
    "vitest": "^3.0.5",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "com.vocabmaster.desktop",
    "productName": "VocabMaster",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "resources/icons"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "resources/vocabularies/**/*",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "win": {
      "icon": "resources/icons/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "VocabMaster-Setup-${version}-win-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "VocabMaster",
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "language": "2052"
    },
    "portable": {
      "artifactName": "VocabMaster-Portable-${version}-win-${arch}.${ext}"
    }
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "electron@35.7.5": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true,
    "vue-demi@0.14.10": true
  }
}
